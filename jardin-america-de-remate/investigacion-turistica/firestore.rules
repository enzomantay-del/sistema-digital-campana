rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /investigacion_2026/{document} {
      allow create: if request.resource.data.respuestas is map
        && (request.resource.data.tiempoRespuesta is int
          || request.resource.data.tiempoRespuesta is float)
        && request.resource.data.userAgent is string
        && request.resource.data.sessionId is string
        && request.resource.data.completed is bool;

      allow update: if request.auth != null
        || resource.data.sessionId == request.resource.data.sessionId;

      allow read: if request.auth != null;

      allow delete: if false;
    }

    match /investigacion_2026_viajeros/{document} {
      allow create: if request.resource.data.respuestas is map
        && (request.resource.data.tiempoRespuesta is int
          || request.resource.data.tiempoRespuesta is float)
        && request.resource.data.userAgent is string
        && request.resource.data.sessionId is string
        && request.resource.data.completed is bool;

      allow update: if request.auth != null
        || resource.data.sessionId == request.resource.data.sessionId;

      allow read: if request.auth != null;

      allow delete: if false;
    }
  }
}
