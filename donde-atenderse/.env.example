DATABASE_URL="file:./dev.db"
# Generá una frase aleatoria de al menos 32 caracteres (no uses el texto del README en producción).
AUTH_SECRET=""
ADMIN_EMAIL="admin@cercalud.local"
# Obligatorio para npm run db:seed en local. En hosting: Secret ADMIN_PASSWORD.
ADMIN_PASSWORD=""

# Producción: omitir o =0 para ocultar datos example y avisos demo (default en NODE_ENV=production).
# CERCALUD_MOSTRAR_EJEMPLOS=1

# Página de contacto y placeholder publicitario.
# CERCALUD_CONTACTO_EMAIL="contacto@cercalud.com.ar"
# CERCALUD_CONTACTO_WHATSAPP=""
# URL canónica para sitemap (opcional en hosting).
# CERCALUD_SITE_URL="https://donde-atenderse.apps.grok.bot"

# Almacenamiento persistente de fotos (producción). Sin esto, en hosting las imágenes pueden perderse al republicar.
